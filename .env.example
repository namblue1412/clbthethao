# CẤU HÌNH FIREBASE AUTHENTICATION DÀNH CHO BAN CHỦ NHIỆM
# Copy nội dung này sang file .env nếu muốn dùng biến môi trường (hoặc điền thẳng vào src/config/firebaseConfig.js)

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=clb-duoc-xxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=clb-duoc-xxx
VITE_FIREBASE_STORAGE_BUCKET=clb-duoc-xxx.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
